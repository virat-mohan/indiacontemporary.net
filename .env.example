# Copy this file to .env.local for local development. In production
# (Vercel), set these under Project Settings -> Environment Variables.

# --- Supabase ---
# From your Supabase project: Settings -> API.
# The URL and anon key are safe to expose to the browser (VITE_ prefix =
# bundled into client code) — they're protected by Row Level Security.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only (used by /api serverless functions, NEVER exposed to the
# browser — do not add a VITE_ prefix to these). The service role key
# bypasses Row Level Security entirely, so it must stay secret.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Resend (transactional email) ---
# From resend.com after verifying a sending domain.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=India Contemporary <onboarding@indiacontemporary.net>

# Comma-separated list of emails notified when a new application is
# submitted, awaiting admin review.
ADMIN_NOTIFICATION_EMAILS=viratmohan@gmail.com,vijit.hooda@gmail.com,portfolio@indiacontemporary.net,udithooda@gmail.com
